# Salin file ini jadi .env di folder yang sama, isi nilainya, JANGAN commit .env asli.

# Port HTTP service ini (Laravel akan memanggil http://127.0.0.1:PORT)
PORT=3001

# Secret bebas (mis. hasil `openssl rand -hex 32`) — WAJIB SAMA PERSIS dengan
# "API Key / Token" yang diisi di Pengaturan Sistem > Gateway WhatsApp di Laravel,
# provider "Self-Host (Baileys)". Ini yang mengunci endpoint /send supaya tidak
# bisa dipanggil sembarang orang yang tahu alamat service ini.
API_KEY=ganti-dengan-secret-acak-yang-panjang
